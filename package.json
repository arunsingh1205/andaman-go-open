{
  "name": "andaman-go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:icons": "capacitor-assets generate --android",
    "cap:icons:ios": "capacitor-assets generate --ios",
    "cap:sync:customer": "set CAP_TARGET=customer&& cap sync android",
    "cap:android:customer": "set CAP_TARGET=customer&& cap open android",
    "cap:icons:customer": "capacitor-assets generate --android --assetPath resources-customer --androidProject android-app",
    "cap:sync:ios:customer": "set CAP_TARGET=customer&& cap sync ios",
    "cap:ios:customer": "set CAP_TARGET=customer&& cap open ios",
    "cap:icons:ios:customer": "capacitor-assets generate --ios --assetPath resources-customer --iosProject ios-app/App",
    "build:brochure": "node scripts/build-partner-brochure.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "jsqr": "^1.4.0",
    "meta-app-events": "file:capacitor-plugins/meta-app-events",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "razorpay-native": "file:capacitor-plugins/razorpay-native",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
