# Copy this to .env.local and fill in real values. Nothing here is a secret —
# it's just the list of what the app reads from process.env, so a new
# machine (or a new engineer) doesn't have to grep for it.

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role key (Project Settings -> API) — bypasses RLS, never expose to
# the client. Needed by lib/supabase-admin.ts to create a login before
# someone has ever signed in themselves: ops partner onboarding and the
# admin Staff invite flow both use it. Without it those two flows throw at
# runtime; nothing else in the app needs it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ----------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Outbound email (lib/email.ts) — Resend --------------------------------
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Outbound WhatsApp (lib/whatsapp.ts) — Twilio ---------------------------
# All optional: unset means WhatsApp sends are skipped with a console
# warning, same as an unset RESEND_API_KEY does for email. A production
# WhatsApp sender + approved Content Templates are required before any of
# this actually reaches a real customer outside a 24-hour reply window — see
# supabase/functions/send-notification's header comment for the full list of
# templates needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_PARTNER_WELCOME=
TWILIO_TEMPLATE_SETTLEMENT_READY=
TWILIO_TEMPLATE_SETTLEMENT_PAID=

# --- Traveller phone OTP (lib/phone-otp.ts) — Twilio Verify -----------------
# A different Twilio product from WhatsApp above — works on a trial account,
# no funding or template approval needed. Create one Verify Service (Console
# → Verify → Services, or POST https://verify.twilio.com/v2/Services) and use
# its SID here. Shares TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above.
TWILIO_VERIFY_SERVICE_SID=

# --- App/Play Store review sign-in ------------------------------------------
# One phone number that skips Twilio Verify and accepts DEMO_OTP as its code.
# App Store and Play reviewers sit outside India and cannot receive an Indian
# SMS, so without this the customer app fails review at the login screen. Set
# BOTH or neither — with either unset the bypass does not exist and every
# number goes through Twilio (see lib/phone-otp.ts). Use a number you control,
# put it and the code in App Store Connect's App Review Information, and
# rotate DEMO_OTP after each review round. Leave both blank outside production.
DEMO_PHONE=
DEMO_OTP=

# --- Weekly settlement cron (app/api/cron/settlement) -----------------------
# Also checked independently inside run_settlement_cron (105) against a
# Supabase Vault secret named 'cron_secret' — set that separately in the
# Supabase dashboard, it does not live here.
CRON_SECRET=

# --- Preview / misc ----------------------------------------------------------
PREVIEW_KEY=
SITE_MODE=
CAP_SERVER_URL=

# --- Supabase Edge Function secrets (NOT read from this file — set via
#     `supabase secrets set NAME=value` or the dashboard, separate store from
#     Vercel/`.env.local`) ----------------------------------------------------
#   supabase/functions/send-partner-push:
#     FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
#     PARTNER_PUSH_WEBHOOK_SECRET
#   supabase/functions/send-notification:
#     RESEND_API_KEY, SITE_URL, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
#     TWILIO_WHATSAPP_FROM, TWILIO_TEMPLATE_BOOKING_PARTNER,
#     TWILIO_TEMPLATE_BOOKING_CUSTOMER, TWILIO_TEMPLATE_PARTNER_WELCOME,
#     TWILIO_TEMPLATE_SETTLEMENT_READY, TWILIO_TEMPLATE_SETTLEMENT_PAID,
#     NOTIFICATION_WEBHOOK_SECRET
