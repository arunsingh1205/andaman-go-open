# Copy this file to keystore.properties (same folder) and fill in real values
# once you've created a release keystore. keystore.properties itself is
# gitignored — never commit real passwords. This is a separate keystore from
# the partner app's (android/app/keystore.properties.example) — a signing
# key is scoped to one Play Store listing, never shared.
#
# Create the keystore first, e.g.:
#   keytool -genkeypair -v -keystore andaman-go.jks -alias andaman-go \
#     -keyalg RSA -keysize 2048 -validity 10000
# Or use Android Studio: Build -> Generate Signed Bundle / APK -> Create new...
# Back the .jks file up somewhere safe — losing it means you can never
# update the Play Store listing under the same app again.

storeFile=../andaman-go.jks
storePassword=
keyAlias=andaman-go
keyPassword=
